/**
 * @file board_control.hpp
 * @brief High-level board control layer for Modbus RTU analog I/O
 *
 * *** HARDWARE CHANGE: CONTEC CAIO REMOVED ***
 * This layer has been refactored to use Modbus RTU instead of CONTEC AIO driver.
 * 
 * Hardware configuration:
 * - Input: 16 channels int16_t (HX711: 0-7ch, ADS1115: 8-15ch)
 * - Output: 8 channels uint16_t (GP8403: 0-7ch, 0-10000mV)
 * - Baudrate: Fixed 38400bps
 * - FIFO buffering/averaging removed (Modbus assumes no noise)
 * - All Modbus I/O happens ONLY from Timer 1 (100ms)
 */

#pragma once

#include "Board.hpp"
#include <Windows.h>
#include <chrono>
#include <expected>
#include <filesystem>
#include <span>
#include <string>
#include <string_view>
#include <vector>

namespace board_control
{

/**
 * @brief Board initialization result (simplified for Modbus)
 */
struct InitResult
{
    std::string portName; // COM port used for Modbus RTU
};

/**
 * @brief Initialize Modbus RTU connection
 * @param portName COM port name (e.g., "COM1", "COM3")
 * @return Expected with InitResult or error message
 *
 * *** BREAKING CHANGE: Signature changed from template with device names to simple port name ***
 * Old signature: InitializeBoards(adDeviceNames, daDeviceNames)
 * New signature: InitializeBoards(portName)
 * 
 * This replaces the CONTEC AIO board initialization with Modbus RTU.
 * Sets up board state in board:: namespace and opens Modbus connection.
 */
[[nodiscard]] std::expected<InitResult, std::string> InitializeBoards(
    const std::string_view portName) noexcept;

/**
 * @brief Reset all D/A voltage outputs to 0V
 * @return Expected with void or error message
 *
 * This function sets all DAVout channels to 0.0f and writes them to hardware.
 * Should be called before closing boards to ensure devices stop safely.
 */
[[nodiscard]] std::expected<void, std::string> ResetAllVoltageOutputs() noexcept;

/**
 * @brief Close all initialized boards
 * @return Expected with void or error message
 *
 * This consolidates CloseBoard() logic from DigitShowDSTDoc.
 */
[[nodiscard]] std::expected<void, std::string> CloseBoards() noexcept;

/**
 * @brief Read analog inputs via Modbus RTU and populate Vout array
 * @return Expected with void or error message
 *
 * *** SIMPLIFIED: No FIFO buffering, no averaging ***
 * Calls modbus_rtu::read_input_registers() to get 16 int16_t values.
 * Converts raw int16_t to voltages and stores in variables::Vout[].
 * MUST be called ONLY from Timer 1 (100ms interval).
 */
[[nodiscard]] std::expected<void, std::string> ReadAnalogInputs() noexcept;

/**
 * @brief Write analog outputs via Modbus RTU with change detection
 * @return Expected with void or error message
 *
 * *** OPTIMIZED: Only writes if values changed ***
 * Converts variables::DAVout[] voltages to uint16_t millivolts (0-10000 range).
 * Compares with previous values and only calls modbus_rtu::write_holding_registers()
 * if any value changed. Clamps to [0, 10000] mV range.
 * MUST be called ONLY from Timer 1 (100ms interval), after ReadAnalogInputs().
 */
[[nodiscard]] std::expected<void, std::string> WriteAnalogOutputs() noexcept;

/**
 * @brief Configure FIFO sampling mode for A/D boards
 * @param hWnd Window handle for event notifications
 * @param samplingClockUs Sampling clock period in microseconds
 * @param samplingTimes Number of samples per event
 * @return Expected with void or error message
 *
 * *** DEPRECATED: FIFO not used with Modbus RTU ***
 * This function is kept for API compatibility but logs a warning.
 * Modbus RTU provides direct reads without FIFO buffering.
 */
[[deprecated("FIFO sampling not supported with Modbus RTU backend")]]
[[nodiscard]] std::expected<void, std::string> ConfigureFifoSampling(HWND hWnd, const float samplingClockUs,
                                                                     const unsigned long samplingTimes) noexcept;

/**
 * @brief Get A/D sampling count from all boards
 * @return Expected with minimum sampling count across all boards, or error message
 *
 * *** DEPRECATED: FIFO not used with Modbus RTU ***
 * This function is kept for API compatibility but logs a warning.
 */
[[deprecated("FIFO sampling not supported with Modbus RTU backend")]]
[[nodiscard]] std::expected<long, std::string> GetMinimumSamplingCount() noexcept;

/**
 * @brief Retrieve sampling data from A/D boards
 * @param samplingTimes Number of samples to retrieve
 * @return Expected with actual samples retrieved, or error message
 *
 * *** DEPRECATED: FIFO not used with Modbus RTU ***
 * This function is kept for API compatibility but logs a warning.
 */
[[deprecated("FIFO sampling not supported with Modbus RTU backend")]]
[[nodiscard]] std::expected<long, std::string> GetSamplingData(long samplingTimes) noexcept;

/**
 * @brief Reset A/D memory and restart sampling
 * @return Expected with void or error message
 *
 * *** DEPRECATED: FIFO not used with Modbus RTU ***
 * This function is kept for API compatibility but logs a warning.
 */
[[deprecated("FIFO sampling not supported with Modbus RTU backend")]]
[[nodiscard]] std::expected<void, std::string> ResetAndRestartSampling() noexcept;

/**
 * @brief Configure initial sampling after board initialization
 * @param hWnd Window handle for event notifications
 * @return Expected with void or error message
 *
 * *** DEPRECATED: FIFO not used with Modbus RTU ***
 * This function is kept for API compatibility but logs a warning.
 * With Modbus RTU, no initial sampling configuration is needed.
 */
[[deprecated("FIFO sampling not supported with Modbus RTU backend")]]
[[nodiscard]] std::expected<void, std::string> ConfigureInitialSampling(HWND hWnd) noexcept;

} // namespace board_control
